<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<NoWarn>CS1591</NoWarn>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<OpenApiDocumentsDirectory>.</OpenApiDocumentsDirectory>
		<OpenApiGenerateDocumentsOptions>--file-name open-api --document-name v1</OpenApiGenerateDocumentsOptions>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Carter" Version="9.0.0" />
		<PackageReference Include="Microsoft.AspnetCore.openApi" Version="9.0.4" />
		<PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="9.0.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
		<PackageReference Include="Scalar.AspNetCore" Version="2.2.1" />
		<PackageReference Include="Serilog" Version="4.2.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<PackageReference Include="Serilog.Sinks.Seq" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\NEW\AlmasGallery.New\almasgallery.new.client\almasgallery.new.esproj" />
		<ProjectReference Include="..\Catalog.Application\Catalog.Application.Contract\Catalog.Application.Contract.csproj" />
		<ProjectReference Include="..\Catalog.Application\Catalog.Application.Model\Catalog.Application.Model.csproj" />
		<ProjectReference Include="..\Catalog.Common\Catalog.Common.DependencyInjection\Catalog.Common.DependencyInjection.csproj" />
		<ProjectReference Include="..\Catalog.Domain\Catalog.Domain.Model\Catalog.Domain.Model.csproj" />
	</ItemGroup>

</Project>
