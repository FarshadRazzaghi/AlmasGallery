  "components": {
    "schemas": {
      "CustomFieldDataType": {
        "enum": [
          1,
          2,
          3,
          4
        ],
        "type": "integer",
        "description": "Represents the data type of a custom field.",
        "format": "byte",
        "x-enumDescriptions": {
          "1": "Number",
          "2": "String",
          "3": "Date",
          "4": "Boolean"
        }
      },
      "CustomFieldGroupEntityType": {
        "enum": [
          1
        ],
        "type": "integer",
        "description": "Represents the entity type of a custom field group.",
        "format": "byte",
        "x-enumDescriptions": {
          "1": "Product"
        }
      },
      "CustomFieldGroupLocationType": {
        "enum": [
          1,
          2,
          3
        ],
        "type": "integer",
        "description": "Represents the location type of a custom field group.",
        "format": "byte",
        "x-enumDescriptions": {
          "1": "PageSection",
          "2": "PricingSection",
          "3": "DescriptionSection"
        }
      },
      "CustomFieldGroupRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Gets or sets the name of the custom field group.\n            This property is required and cannot be null or empty."
          },
          "entityType": {
            "$ref": "#/components/schemas/CustomFieldGroupEntityType"
          },
          "customFields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomFieldRequest"
            }
          }
        },
        "description": "Represents a custom field group data transfer object."
      },
      "CustomFieldGroupResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Gets or sets the ID of the custom field group.",
            "format": "int64"
          },
          "name": {
            "type": "string",
            "description": "Gets or sets the name of the custom field group."
          },
          "entityType": {
            "$ref": "#/components/schemas/CustomFieldGroupEntityType"
          },
          "customFields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomFieldResponse"
            }
          }
        },
        "description": "Represents a response object for a custom field group."
      },
      "CustomFieldRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Gets or sets the ID of the custom field.\n            This property is required and cannot be null or empty.",
            "format": "int64"
          },
          "uniqueId": {
            "type": "string",
            "description": "Gets or sets the unique identifier of the custom field.\n            This property is required and cannot be null or empty.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Gets or sets the name of the custom field.\n            This property is required and cannot be null or empty."
          },
          "dataType": {
            "$ref": "#/components/schemas/CustomFieldDataType"
          },
          "isActive": {
            "type": "boolean",
            "description": "Gets or sets a value indicating whether the custom field is active."
          },
          "isRequired": {
            "type": "boolean",
            "description": "Gets or sets a value indicating whether the custom field is required."
          },
          "helpText": {
            "type": "string",
            "description": "Gets or sets the help text for the custom field.",
            "nullable": true
