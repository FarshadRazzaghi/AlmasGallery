{
	"name": "@almas-gallery/admin-dashboard",
	"version": "1.0.0",
	"scripts": {
		"ng": "ng",
		"start": "run-script-os",
		"start:backend": "cd ../../BackendApplication/Catalog.MicroService/Catalog.API && dotnet run",
		"start:windows": "ng serve --ssl --ssl-cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --ssl-key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\" --host=127.0.0.100",
		"start:default": "ng serve --ssl --ssl-cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --ssl-key \"$HOME/.aspnet/https/${npm_package_name}.key\" --host=127.0.0.100",
		"prestart": "node aspnetcore-https",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"serve:ssr:admin-dashboard": "node dist/project/dashboard/server/server.mjs",
		"update:widget": "npm uninstall @fr-theme/common && npm install \"file:E:\\Application Projects\\Tebyar\\AngularWidget\\dist\\fr-theme-common-1.0.0.tgz\"",
		"update:generator": "npm uninstall @almas-gallery/generator && npm install \"file:..\\generator\\dist\\almas-gallery-generator-0.0.1.tgz",
		"generate:enums": "ng g @almas-gallery/generator:enums --path src/app",
		"generate:endpoints": "ng g @almas-gallery/generator:endpoints --path src/app --interfaces true",
		"lint": "ng lint"
	},
	"private": true,
	"dependencies": {
		"@almas-gallery/generator": "file:../generator/dist/almas-gallery-generator-0.0.1.tgz",
		"@angular/animations": "^19.1.1",
